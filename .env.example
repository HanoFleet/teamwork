# 复制为 .env 后填写。不要把填好的 .env 提交到 Git。
# 口令和 SESSION_SECRET 由你自己生成，示例文件里故意留空。

WEB_PORT=8080
APP_VERSION=v2.0.0-skeleton
SHUTDOWN_TIMEOUT_SECONDS=10

# 只交给 MySQL 容器，不要配进 api 的环境。
MYSQL_ROOT_PASSWORD=

DB_NAME=campusclaw
DB_USER=campusclaw
DB_PASSWORD=

SESSION_SECRET=

SEED_TEACHER_PASSWORD=
SEED_STUDENT_A_PASSWORD=
SEED_STUDENT_B_PASSWORD=

MAX_UPLOAD_BYTES=1048576
SESSION_TTL_HOURS=12
LOGIN_FAIL_THRESHOLD=5
LOGIN_LOCK_MINUTES=15

# 检索。Compose 内 Qdrant 不映射宿主端口。EMBEDDING_URL / CHAT_URL 填 local 时走进程内实现，不调外网。
QDRANT_URL=http://qdrant:6333
EMBEDDING_URL=local
EMBEDDING_API_KEY=local
EMBEDDING_MODEL=local-ngram-256
CHAT_URL=local
CHAT_API_KEY=local
CHAT_MODEL=local-extractive

# 第 8 课异步批改规约（实现后启用；当前 Compose 不读取这些键）
