index 58ccbd3..1db2f3a 100644
--- a/backend/Dockerfile
+++ b/backend/Dockerfile
@@ -1,7 +1,8 @@
 FROM golang:1.26.11-alpine AS build
 WORKDIR /src
 COPY go.mod go.sum ./
-RUN go mod download
+ARG GOPROXY=https://proxy.golang.org,direct
+RUN GOPROXY="$GOPROXY" go mod download
 COPY . .
 RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -o /out/server ./cmd/server \
  && CGO_ENABLED=0 GOOS=linux go build -trimpath -o /out/worker ./cmd/worker
diff --git a/backend/internal/outbox/dispatcher.go b/backend/internal/outbox/dispatcher.go
index 0ccdc00..22ec074 100644
--- a/backend/internal/outbox/dispatcher.go
+++ b/backend/internal/outbox/dispatcher.go
@@ -42,7 +42,8 @@ func (d *Dispatcher) flush(ctx context.Context) error {
 	if d.broker == nil {
 		return nil
 	}
-	tx, err := d.db.BeginTx(ctx, nil)
+	// Keep batch row locks without gap-locking new outbox inserts while awaiting confirms.
+	tx, err := d.db.BeginTx(ctx, &sql.TxOptions{Isolation: sql.LevelReadCommitted})
 	if err != nil {
 		return err
 	}
